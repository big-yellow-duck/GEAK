+            os.makedirs(os.path.dirname(os.path.abspath(shape_log)), exist_ok=True)
+            payload = (json.dumps(record, sort_keys=True) + "\n").encode()
+            fd = os.open(shape_log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
+            try:
+                os.write(fd, payload)
