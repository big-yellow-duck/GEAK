+                "b_stride": list(B.stride()),
+                "as_stride": list(As.stride()),
+                "bs_stride": list(Bs.stride()),
+                "a_dtype": str(A.dtype).removeprefix("torch."),
+                "b_dtype": str(B.dtype).removeprefix("torch."),
+                "as_dtype": str(As.dtype).removeprefix("torch."),
